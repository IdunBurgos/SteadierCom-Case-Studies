    "bash '../scripts_bash/smetana_run.sh'\n",
    "\"\"\"\n",
    "\n",
    "with open(\"../output/Venturelli2018/smetana/err_log.txt\",'w') as ferr:\n",
    "    process = subprocess.Popen(bash_script,\n",
    "                               shell=True,\n",
    "                               text=True,\n",
    "                               executable=\"/bin/bash\",\n",
    "                               stdout=subprocess.PIPE,\n",
    "                               stderr=ferr)\n",
    "\n",
    "    while True:\n",
    "        line = process.stdout.readline()\n",
    "        if not line:\n",
    "            break\n",
    "        print(line.rstrip(), flush=True)"
